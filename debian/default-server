# Параметры службы poma-vpn-server. После изменения: systemctl restart poma-vpn-server
#
# --port            UDP-порт, его же указать клиентам
# --tun-ip          адрес сервера в туннеле, клиенты получают адреса из его /24
# --external-iface  интерфейс для NAT; без параметра - интерфейс маршрута по умолчанию
# --mtu             MTU туннеля; 1380 оставляет запас на 44 байта шифрования и заголовки
# Ключ задавать не нужно: systemd передаёт /etc/poma-vpn/key через LoadCredential.
VPN_SERVER_OPTS="--port 51820 --mtu 1380"
