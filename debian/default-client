# Параметры службы poma-vpn-client. После изменения: systemctl restart poma-vpn-client
#
# --server  IPv4-адрес сервера (обязательно)
# --port    UDP-порт сервера
# --tun-ip  адрес клиента в туннеле, из /24 сервера; у каждого клиента свой
# --mtu     MTU туннеля, как на сервере
# Ключ /etc/poma-vpn/key скопировать с сервера (владелец root, права 600).
VPN_CLIENT_OPTS="--server 203.0.113.10 --port 51820 --tun-ip 192.168.200.2 --mtu 1380"
